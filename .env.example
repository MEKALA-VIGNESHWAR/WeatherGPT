# =======================================================
# WeatherGPT Environment Configuration
# =======================================================

# Core Settings
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=false

# Database Configuration (PostgreSQL / PostGIS or SQLite)
DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db
SYNC_DATABASE_URL=sqlite:///./weathergpt.db
POSTGIS_ENABLED=false

# Redis Cache (Leave blank to use robust In-Memory TTL cache)
REDIS_URL=

# AI & LLM Provider (Optional: Defaults to Grounded Rule Reasoning if not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Weather API Integrations
# Default: open_meteo (Active real-time, global + IMD grid, no key needed)
DEFAULT_WEATHER_PROVIDER=open_meteo

# IMD (India Meteorological Department) Credentials (Optional)
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=

# NWP Model Endpoints (Optional)
GFS_BASE_URL=https://nomads.ncep.noaa.gov
WRF_BASE_URL=

# Security
JWT_SECRET=dev_super_secret_jwt_key_sih2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Map Tiles
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Voice Configuration
STT_PROVIDER=browser
TTS_PROVIDER=browser
